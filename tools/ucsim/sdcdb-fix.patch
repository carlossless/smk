-  /* now that we have opened, wait for the prompt */
-  waitForSim(200,NULL);
+  /* now that we have opened, drain the whole startup splash. uCsim emits
+     TWO '\0' prompts here (one after the telnet handshake, one after the
+     banner); the old single waitForSim(200) consumed only the first, leaving
+     the second in the socket and shifting every later reply by one command
+     (so e.g. the 'pc' after a run reads the run's output and the stop address
+     parses as 0). Read until the socket is idle so framing starts clean. */
+  {
+    fd_set rfds;
+    struct timeval tv;
+    char tmp[512];
+    for (;;)
+      {
+        FD_ZERO(&rfds);
+        FD_SET(sock, &rfds);
+        tv.tv_sec = 0;
+        tv.tv_usec = 300000;       /* 300 ms with no data => splash done */
+        if (select(sock + 1, &rfds, NULL, NULL, &tv) <= 0)
+            break;
+        if (recv(sock, tmp, sizeof(tmp), 0) <= 0)
+            break;
+      }
+  }
   simactive = 1;
 }
